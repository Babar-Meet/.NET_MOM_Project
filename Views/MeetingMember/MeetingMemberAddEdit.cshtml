@model MOM_Project.Models.MeetingMemberModel

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Vertical Form</h5>

        <!-- Vertical Form -->
        <form class="row g-3" asp-action="saveMeetingMember">
            <div class="col-12">
                <label for="meetingId" class="form-label" asp-for="MeetingID">Meeting ID</label>
                <input type="number" class="form-control" id="meetingId" asp-for="MeetingID">
                <span asp-validation-for="MeetingID"></span>
            </div>

            <div class="col-12">
                <label for="staffId" class="form-label" asp-for="StaffID">Staff ID</label>
                <input type="number" class="form-control" id="staffId" asp-for="StaffID">
                <span asp-validation-for="StaffID"></span>
            </div>

            <div class="col-12">
                <label for="isPresent" class="form-label" asp-for="IsPresent">Is Present</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="isPresent" asp-for="IsPresent">
                    <label class="form-check-label" for="isPresent">
                        Present
                    </label>
                </div>
            </div>

            <div class="col-12">
                <label for="remarks" class="form-label" asp-for="Remarks">Remarks</label>
                <textarea class="form-control" id="remarks" rows="3" asp-for="Remarks"></textarea>
                <span asp-validation-for="Remarks"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary">Submit</button>
                <button type="reset" class="btn btn-secondary">Reset</button>
                <a asp-controller="MeetingMember"
                   asp-action="MeetingMemberList"
                   class="btn btn-danger">
                    Cancel
                </a>
            </div>
        </form><!-- Vertical Form -->
    </div>
</div>