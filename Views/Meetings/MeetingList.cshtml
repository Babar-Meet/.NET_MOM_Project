@{
    ViewData["Title"] = "Meeting List";
}

<div class="pagetitle d-flex justify-content-between align-items-center mb-3">
    <h1 class="m-0">Meeting Table</h1>

    <a asp-action="MeetingAddEdit" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add
    </a>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="mt-3 mb-3">
                        <input type="text" id="meetingSearch" class="form-control" placeholder="Search Meetings...">
                    </div>
                    <!-- Table with stripped rows -->
                    <table class="table table-striped" id="meetingTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Date</th>
                                <th>Venue</th>
                                <th>Type</th>
                                <th>Department</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.Meetings != null)
                            {
                                @foreach (var meeting in ViewBag.Meetings as List<MOM_Project.Models.MeetingsModel>)
                                {
                                    <tr>
                                        <td>@meeting.MeetingID</td>
                                        <td>@meeting.MeetingDate.ToShortDateString() @meeting.MeetingDate.ToShortTimeString()</td>
                                        <td>@meeting.MeetingVenueName</td>
                                        <td>@meeting.MeetingTypeName</td>
                                        <td>@meeting.DepartmentName</td>
                                        <td>
                                            @if (meeting.IsCancelled)
                                            {
                                                <span class="badge bg-danger">Cancelled</span>
                                            }
                                            else if (meeting.MeetingDate < DateTime.Now)
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">Upcoming</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="MeetingAddEdit" asp-route-id="@meeting.MeetingID" class="btn btn-sm btn-primary">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@meeting.MeetingID" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.getElementById('meetingSearch').addEventListener('keyup', function() {
        let value = this.value.toLowerCase();
        let rows = document.querySelectorAll('#meetingTable tbody tr');
        rows.forEach(row => {
            row.style.display = row.innerText.toLowerCase().includes(value) ? '' : 'none';
        });
    });
</script>