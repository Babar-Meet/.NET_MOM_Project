@model MOM_Project.Models.MeetingsModel

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Meeting Form</h5>

        <form class="row g-3" asp-action="saveMeeting" method="post">
            <input type="hidden" asp-for="MeetingID" />

            <div class="col-12">
                <label class="form-label" asp-for="MeetingDate">Meeting Date</label>
                <input type="datetime-local" class="form-control" asp-for="MeetingDate">
                <span class="text-danger" asp-validation-for="MeetingDate"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="MeetingVenueID">Meeting Venue</label>
                <select class="form-select" asp-for="MeetingVenueID">
                    <option value="">-- Select Venue --</option>
                    @if (ViewBag.Venues != null)
                    {
                        @foreach (var v in ViewBag.Venues as List<MOM_Project.Models.MeetingVenueModel>)
                        {
                            <option value="@v.MeetingVenueID">@v.MeetingVenueName</option>
                        }
                    }
                </select>
                <span class="text-danger" asp-validation-for="MeetingVenueID"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="MeetingTypeID">Meeting Type</label>
                <select class="form-select" asp-for="MeetingTypeID">
                    <option value="">-- Select Type --</option>
                    @if (ViewBag.MeetingTypes != null)
                    {
                        @foreach (var t in ViewBag.MeetingTypes as List<MOM_Project.Models.MeetingTypeModel>)
                        {
                            <option value="@t.MeetingTypeID">@t.MeetingTypeName</option>
                        }
                    }
                </select>
                <span class="text-danger" asp-validation-for="MeetingTypeID"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="DepartmentID">Department</label>
                <select class="form-select" asp-for="DepartmentID">
                    <option value="">-- Select Department --</option>
                    @if (ViewBag.Departments != null)
                    {
                        @foreach (var d in ViewBag.Departments as List<MOM_Project.Models.DepartmentModel>)
                        {
                            <option value="@d.DepartmentID">@d.DepartmentName</option>
                        }
                    }
                </select>
                <span class="text-danger" asp-validation-for="DepartmentID"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="MeetingDescription">Meeting Description</label>
                <textarea class="form-control" rows="3" asp-for="MeetingDescription"></textarea>
                <span class="text-danger" asp-validation-for="MeetingDescription"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="DocumentPath">Document Path</label>
                <input type="text" class="form-control" asp-for="DocumentPath">
                <span class="text-danger" asp-validation-for="DocumentPath"></span>
            </div>

            <div class="col-12">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" asp-for="IsCancelled">
                    <label class="form-check-label" asp-for="IsCancelled">Is Cancelled</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="CancellationDateTime">Cancellation Date Time</label>
                <input type="datetime-local" class="form-control" asp-for="CancellationDateTime">
                <span class="text-danger" asp-validation-for="CancellationDateTime"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="CancellationReason">Cancellation Reason</label>
                <textarea class="form-control" rows="2" asp-for="CancellationReason"></textarea>
                <span class="text-danger" asp-validation-for="CancellationReason"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary">Submit</button>
                <button type="reset" class="btn btn-secondary">Reset</button>
                <a asp-action="MeetingList" class="btn btn-danger">Cancel</a>
            </div>
        </form>
    </div>
</div>