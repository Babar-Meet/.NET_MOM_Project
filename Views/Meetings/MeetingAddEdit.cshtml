@model MOM_Project.Models.MeetingsModel

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Vertical Form</h5>

        <!-- Vertical Form -->
        <form class="row g-3" asp-action="saveMeeting">
            <div class="col-12">
                <label class="form-label" asp-for="MeetingDate">Meeting Date</label>
                <input type="datetime-local" class="form-control" asp-for="MeetingDate">
                <span asp-validation-for="MeetingDate"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="MeetingVenue">Meeting Venue</label>
                <input type="text" class="form-control" asp-for="MeetingVenue">
                <span asp-validation-for="MeetingVenue"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="MeetingType">Meeting Type</label>
                <input type="text" class="form-control" asp-for="MeetingType">
                <span asp-validation-for="MeetingType"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="Department">Department</label>
                <input type="text" class="form-control" asp-for="Department">
                <span asp-validation-for="Department"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="MeetingDescription">Meeting Description</label>
                <textarea class="form-control" rows="3" asp-for="MeetingDescription"></textarea>
                <span asp-validation-for="MeetingDescription"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="DocumentPath">Document Path</label>
                <input type="text" class="form-control" asp-for="DocumentPath">
                <span asp-validation-for="DocumentPath"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="IsCancelled">Is Cancelled</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="IsCancelled">
                    <label class="form-check-label">
                        Cancelled
                    </label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="CancellationDateTime">Cancellation Date Time</label>
                <input type="datetime-local" class="form-control" asp-for="CancellationDateTime">
                <span asp-validation-for="CancellationDateTime"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="CancellationReason">Cancellation Reason</label>
                <textarea class="form-control" rows="2" asp-for="CancellationReason"></textarea>
                <span asp-validation-for="CancellationReason"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary">Submit</button>
                <button type="reset" class="btn btn-secondary">Reset</button>
                <a asp-controller="Meetings"
                   asp-action="MeetingList"
                   class="btn btn-danger">
                    Cancel
                </a>
            </div>
        </form><!-- Vertical Form -->
    </div>
</div>