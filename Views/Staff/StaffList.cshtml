@{
    ViewData["Title"] = "Staff List";
}

<div class="pagetitle d-flex justify-content-between align-items-center mb-3">
    <h1 class="m-0">Staff Table</h1>

    <a asp-action="StaffAddEdit" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add
    </a>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="mt-3 mb-3">
                        <input type="text" id="staffSearch" class="form-control" placeholder="Search Staff...">
                    </div>
                    <!-- Table with stripped rows -->
                    <table class="table table-striped" id="staffTable">
                        <thead>
                            <tr>
                                <th>Staff ID</th>
                                <th>Department</th>
                                <th>Staff Name</th>
                                <th>Mobile No</th>
                                <th>Email Address</th>
                                <th>Remarks</th>
                                <th>Created</th>
                                <th>Modified</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.StaffList != null)
                            {
                                @foreach (var staff in ViewBag.StaffList as List<MOM_Project.Models.StaffModel>)
                                {
                                    <tr>
                                        <td>@staff.StaffID</td>
                                        <td>@staff.DepartmentName</td>
                                        <td>@staff.StaffName</td>
                                        <td>@staff.MobileNo</td>
                                        <td>@staff.EmailAddress</td>
                                        <td>@staff.Remarks</td>
                                        <td>@staff.Created.ToShortDateString()</td>
                                        <td>@staff.Modified.ToShortDateString()</td>
                                        <td>
                                            <a asp-action="StaffAddEdit" asp-route-id="@staff.StaffID" class="btn btn-sm btn-primary">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@staff.StaffID" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.getElementById('staffSearch').addEventListener('keyup', function() {
        let value = this.value.toLowerCase();
        let rows = document.querySelectorAll('#staffTable tbody tr');
        rows.forEach(row => {
            row.style.display = row.innerText.toLowerCase().includes(value) ? '' : 'none';
        });
    });
</script>