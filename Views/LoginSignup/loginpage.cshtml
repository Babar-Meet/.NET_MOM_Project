@model MOM_Project.Models.UserModel
@{
    Layout = null;
}
<link rel="stylesheet" href="~/assets/loginsignup/style.css">

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2>Welcome Back</h2>
            <p>Sign in to your account</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-message" style="display:block; color:#ff4d4f; text-align:center; margin-bottom: 15px; font-weight: bold;">
                @Html.ValidationSummary(true, "")
            </div>
        }

        <form class="login-form" id="loginForm" asp-controller="LoginSignup" asp-action="loginPage" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div class="form-group">
                <div class="input-wrapper">
                    <input type="text" id="email" name="Username" required autocomplete="username" value="@(Model?.Username ?? "")">
                    <label for="email">Username</label>
                    <span class="focus-border"></span>
                </div>
                <span class="error-message" id="emailError"></span>
            </div>

            <div class="form-group">
                <div class="input-wrapper password-wrapper">
                    <input type="password" id="password" name="Password" required autocomplete="current-password">
                    <label for="password">Password</label>
                    <button type="button" class="password-toggle" id="passwordToggle" aria-label="Toggle password visibility">
                        <span class="eye-icon"></span>
                    </button>
                    <span class="focus-border"></span>
                </div>
                <span class="error-message" id="passwordError"></span>
            </div>

            <div class="form-options">
                <label class="remember-wrapper">
                    <input type="checkbox" id="remember" name="remember">
                    <span class="checkbox-label">
                        <span class="checkmark"></span>
                        Remember me
                    </span>
                </label>
                <a href="#" class="forgot-password">Forgot password?</a>
            </div>

            <button type="submit" class="login-btn btn">
                <span class="btn-text">Sign In</span>
                <span class="btn-loader"></span>
            </button>
        </form>

        <div class="divider">
            <span>or continue with</span>
        </div>

        <div class="social-login">
            <button type="button" class="social-btn google-btn">
                <span class="social-icon google-icon"></span>
                Google
            </button>
            <button type="button" class="social-btn github-btn">
                <span class="social-icon github-icon"></span>
                GitHub
            </button>
        </div>

        <div class="signup-link">
            <p>
                Don't have an account? <a href="/loginSignup/SignupPage">Sign up</a></p>
        </div>

        <div class="success-message" id="successMessage">
            <div class="success-icon">✓</div>
            <h3>Login Successful!</h3>
            <p>Redirecting to your dashboard...</p>
        </div>
    </div>
</div>

<script src="~/assets/loginsignup/script.js"></script>
<script src="~/assets/shared/js/form-utils.js"></script>