@{
    ViewData["Title"] = "Meeting Venue List";
}

<div class="pagetitle d-flex justify-content-between align-items-center mb-3">
    <h1 class="m-0">Meeting Venue Table</h1>

    <a asp-action="MeetingVenueAddEdit" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add
    </a>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="mt-3 mb-3">
                        <input type="text" id="venueSearch" class="form-control" placeholder="Search Venues...">
                    </div>
                    <!-- Table with stripped rows -->
                    <table class="table table-striped" id="venueTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Venue Name</th>
                                <th>Created</th>
                                <th>Modified</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.MeetingVenues != null)
                            {
                                @foreach (var venue in ViewBag.MeetingVenues as List<MOM_Project.Models.MeetingVenueModel>)
                                {
                                    <tr>
                                        <td>@venue.MeetingVenueID</td>
                                        <td>@venue.MeetingVenueName</td>
                                        <td>@venue.Created.ToShortDateString()</td>
                                        <td>@venue.Modified.ToShortDateString()</td>
                                        <td>
                                            <a asp-action="MeetingVenueAddEdit" asp-route-id="@venue.MeetingVenueID" class="btn btn-sm btn-primary">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@venue.MeetingVenueID" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.getElementById('venueSearch').addEventListener('keyup', function() {
        let value = this.value.toLowerCase();
        let rows = document.querySelectorAll('#venueTable tbody tr');
        rows.forEach(row => {
            row.style.display = row.innerText.toLowerCase().includes(value) ? '' : 'none';
        });
    });
</script>